{
  "fontSize": 13,
  "lineSpacing": 1.1,
  "colors": {
    "DVTSourceTextBackground": "{color.backdrop}",
    "DVTSourceTextCurrentLineHighlightColor": "{color.surface}",
    "DVTSourceTextSelectionColor": "{color.card-2}",
    "DVTSourceTextInsertionPointColor": "{color.focus}",
    "DVTSourceTextInvisiblesColor": "{color.border}",
    "DVTSourceTextBlockDimBackgroundColor": "{color.muted}",
    "DVTConsoleTextBackgroundColor": "{color.backdrop}",
    "DVTConsoleTextSelectionColor": "{color.card-2}",
    "DVTConsoleTextInsertionPointColor": "{color.focus}",
    "DVTConsoleDebuggerInputTextColor": "{color.ink}",
    "DVTConsoleDebuggerOutputTextColor": "{color.ink-soft}",
    "DVTConsoleDebuggerPromptTextColor": "{color.accent-text}",
    "DVTConsoleExectuableInputTextColor": "{color.ink}",
    "DVTConsoleExectuableOutputTextColor": "{color.ink-soft}",
    "DVTMarkupTextBackgroundColor": "{color.surface}",
    "DVTMarkupTextBorderColor": "{color.border}",
    "DVTMarkupTextNormalColor": "{color.ink-soft}",
    "DVTMarkupTextPrimaryHeadingColor": "{color.ink}",
    "DVTMarkupTextSecondaryHeadingColor": "{color.ink}",
    "DVTMarkupTextOtherHeadingColor": "{color.ink-soft}",
    "DVTMarkupTextStrongColor": "{color.ink}",
    "DVTMarkupTextEmphasisColor": "{color.ink}",
    "DVTMarkupTextInlineCodeColor": "{color.accent-text}",
    "DVTMarkupTextLinkColor": "{color.accent-text}",
    "DVTScrollbarMarkerErrorColor": "{color.danger}",
    "DVTScrollbarMarkerWarningColor": "{color.warn}",
    "DVTScrollbarMarkerAnalyzerColor": "{color.info}",
    "DVTScrollbarMarkerBreakpointColor": "{color.info}",
    "DVTScrollbarMarkerRuntimeIssueColor": "{color.info}",
    "DVTScrollbarMarkerDiffColor": "{color.muted}",
    "DVTScrollbarMarkerDiffConflictColor": "{color.danger}"
  },
  "consoleFonts": {
    "DVTConsoleDebuggerInputTextFont": "SFMono-Regular",
    "DVTConsoleDebuggerOutputTextFont": "SFMono-Regular",
    "DVTConsoleDebuggerPromptTextFont": "SFMono-Bold",
    "DVTConsoleExectuableInputTextFont": "SFMono-Regular",
    "DVTConsoleExectuableOutputTextFont": "SFMono-Regular"
  },
  "syntax": {
    "xcode.syntax.plain": ["{color.ink}", "SFMono-Regular"],
    "xcode.syntax.keyword": ["{color.ink}", "SFMono-Bold"],
    "xcode.syntax.comment": ["{color.muted}", "SFMono-RegularItalic"],
    "xcode.syntax.comment.doc": ["{color.muted}", "SFMono-RegularItalic"],
    "xcode.syntax.comment.doc.keyword": ["{color.ink-soft}", "SFMono-BoldItalic"],
    "xcode.syntax.mark": ["{color.ink}", "SFMono-Bold"],
    "xcode.syntax.string": ["{color.accent-text}", "SFMono-Regular"],
    "xcode.syntax.character": ["{color.accent-text}", "SFMono-Regular"],
    "xcode.syntax.url": ["{color.accent-text}", "SFMono-Regular"],
    "xcode.syntax.number": ["{color.ok}", "SFMono-Regular"],
    "xcode.syntax.attribute": ["{color.info}", "SFMono-Regular"],
    "xcode.syntax.preprocessor": ["{color.info}", "SFMono-Regular"],
    "xcode.syntax.identifier.macro": ["{color.info}", "SFMono-Regular"],
    "xcode.syntax.identifier.macro.system": ["{color.info}", "SFMono-Regular"],
    "xcode.syntax.declaration.type": ["{color.ink}", "SFMono-Bold"],
    "xcode.syntax.declaration.other": ["{color.ink}", "SFMono-Bold"],
    "xcode.syntax.identifier.type": ["{color.ink}", "SFMono-Regular"],
    "xcode.syntax.identifier.type.system": ["{color.ink}", "SFMono-Regular"],
    "xcode.syntax.identifier.class": ["{color.ink}", "SFMono-Regular"],
    "xcode.syntax.identifier.class.system": ["{color.ink}", "SFMono-Regular"],
    "xcode.syntax.identifier.function": ["{color.ink}", "SFMono-Regular"],
    "xcode.syntax.identifier.function.system": ["{color.ink}", "SFMono-Regular"],
    "xcode.syntax.identifier.constant": ["{color.ink-soft}", "SFMono-Regular"],
    "xcode.syntax.identifier.constant.system": ["{color.ink-soft}", "SFMono-Regular"],
    "xcode.syntax.identifier.variable": ["{color.ink-soft}", "SFMono-Regular"],
    "xcode.syntax.identifier.variable.system": ["{color.ink-soft}", "SFMono-Regular"],
    "xcode.syntax.markup.code": ["{color.accent-text}", "SFMono-Regular"],
    "xcode.syntax.markup.aside.kind": ["{color.accent-text}", "SFMono-Bold"]
  }
}
